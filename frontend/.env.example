# Base URL for the Flask API.
# Leave empty to use the Vite dev proxy (recommended for local development):
# requests go to /api/... on the same origin and Vite forwards them to Flask.
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api requests. Defaults to http://127.0.0.1:5000.
VITE_PROXY_TARGET=http://127.0.0.1:5000
